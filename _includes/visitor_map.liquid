<div class="visitor-map-container my-5 pt-2">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 520px; background-color: var(--global-card-bg-color); border: 1px solid var(--global-divider-color) !important; border-radius: 14px; overflow: hidden;">
    <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between" style="background: transparent; border-bottom: 1px solid var(--global-divider-color);">
      <span style="font-size: 0.88rem; font-weight: 600; color: var(--global-text-color);">
        <i class="fa-solid fa-earth-americas mr-1" style="color: var(--global-theme-color);"></i> Visitor Geography
      </span>
      <span class="badge badge-light" style="font-size: 0.72rem; color: var(--global-text-color-light); border: 1px solid var(--global-divider-color);">
        <i class="fa-solid fa-signal text-success mr-1"></i> Live Tracking
      </span>
    </div>
    <div class="card-body p-3 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 150px; overflow-x: auto;">
      {% if site.visitor_map.id and site.visitor_map.id != "" %}
        {% if site.visitor_map.type == "globe" %}
          <script type="text/javascript" id="mmvst_globe" src="https://mapmyvisitors.com/globe.js?d={{ site.visitor_map.id }}"></script>
        {% else %}
          <script type="text/javascript" id="mapmyvisitors" src="https://mapmyvisitors.com/map.js?d={{ site.visitor_map.id }}&cl=ffffff&w=a"></script>
        {% endif %}
      {% else %}
        <div class="py-3 px-2 text-center">
          <div class="mb-2" style="font-size: 1.8rem; color: var(--global-theme-color);">
            <i class="fa-solid fa-map-location-dot"></i>
          </div>
          <h6 class="font-weight-bold mb-1" style="font-size: 0.92rem; color: var(--global-text-color);">
            MapMyVisitors Widget Ready
          </h6>
          <p class="text-muted mb-0" style="font-size: 0.8rem; max-width: 380px; line-height: 1.5;">
            Visualizing visitor geolocation & page views worldwide. Add your MapMyVisitors ID in <code>_config.yml</code> to start live tracking.
          </p>
        </div>
      {% endif %}
    </div>
  </div>
</div>
